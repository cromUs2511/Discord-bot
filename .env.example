# ============================================================
# Blackboard Discord Academic Assistant — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git — it is in .gitignore.
# ============================================================

# ----- Discord -----
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_GUILD_ID=0
DISCORD_NOTIFICATION_CHANNEL_ID=0

# ----- Per-course notification channels (0 = fall back to the general channel) -----
CHANNEL_THESIS_1=0
CHANNEL_CIRCUITS_LAB=0
CHANNEL_CIRCUITS_LECTURE=0
CHANNEL_FEEDBACK_CONTROL=0

# Mention attached to every new notification. Use @everyone, @here, a role
# mention, or leave empty to disable pings.
NOTIFICATION_PING=@everyone

# ----- Blackboard -----
BLACKBOARD_URL=https://your-university.blackboard.com
# No password stored here — authentication is interactive via browser.

# Optional: restrict monitoring to one term, e.g. 2Q2627.
# Leave empty to auto-detect every term on the dashboard.
ACADEMIC_TERM=

# ----- Scheduling -----
# How often (in minutes) to poll Blackboard for changes.
SYNC_INTERVAL_MINUTES=30

# ----- Timezone -----
TIMEZONE=Asia/Manila
# Blackboard scrapes arrive in UTC on this deployment (Manila 11:59 PM shows
# as 3:59 PM); keep "true" so the bot shifts them +8h to Asia/Manila.
BLACKBOARD_SCRAPED_TIMES_UTC=true

# ----- Branding -----
INSTITUTION_NAME=Mapúa University

# ----- Logging -----
LOG_LEVEL=INFO
